{
    "name": "pnscripts/wp-waymend",
    "description": "Development tooling for Waymend by PN Scripts (WordPress redirect manager). The plugin itself has no Composer dependencies.",
    "type": "wordpress-plugin",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "PN Scripts",
            "email": "office@pnscripts.com",
            "homepage": "https://pnscripts.com"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "PNScripts\\WaymendLite\\": "src/",
            "PNScripts\\WaymendLite\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.0.30"
        }
    },
    "support": {
        "email": "office@pnscripts.com"
    }
}
