msgid_plural "Download the %d URLs that need a redirect (CSV)"
msgstr[0] "Изтегли %d адрес, който има нужда от пренасочване (CSV)"
msgstr[1] "Изтегли %d адреса, които имат нужда от пренасочване (CSV)"

