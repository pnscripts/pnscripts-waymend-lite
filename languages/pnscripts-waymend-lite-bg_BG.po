#: src/WordPress/Admin/Messages.php:25
msgid "Enter the old URL (source)."
msgstr "Въведете стария адрес (източник)."

#: src/WordPress/Admin/Messages.php:27
msgid "The source must be a path on this site, such as /old-page."
msgstr "Източникът трябва да е път в този сайт, например /old-page."

#: src/WordPress/Admin/Messages.php:29
msgid "Enter the target URL, or choose 410 Gone."
msgstr "Въведете целевия адрес или изберете 410."

#: src/WordPress/Admin/Messages.php:31
msgid "The target must be a path or an http(s) URL."
msgstr "Целта трябва да е път или http(s) адрес."

#: src/WordPress/Admin/Messages.php:33
msgid "Choose 301, 302, 307 or 410."
msgstr "Изберете 301, 302, 307 или 410."

#: src/WordPress/Admin/Messages.php:35
msgid "Choose exact or prefix matching."
msgstr "Изберете точно или префиксно съвпадение."

#: src/WordPress/Admin/Messages.php:37
msgid "Choose how the query string is handled."
msgstr "Изберете как да се обработва query string-ът."

#. translators: %s: the PCRE error message.
#: src/WordPress/Admin/Messages.php:40
#, php-format
msgid "The regular expression is not valid: %s"
msgstr "Регулярният израз не е валиден: %s"

#. translators: %s: id of the existing rule.
#: src/WordPress/Admin/Messages.php:43
#, php-format
msgid "Rule #%s already uses this source with the same match type."
msgstr "Правило №%s вече използва този източник със същия вид съвпадение."

#: src/WordPress/Admin/Messages.php:45
msgid "This rule would create a redirect loop: following it brings the visitor back to a URL already visited."
msgstr "Това правило би създало цикъл: следвайки го, посетителят се връща на адрес, през който вече е минал."

#. translators: %s: final URL of the redirect chain.
#: src/WordPress/Admin/Messages.php:48
#, php-format
msgid "The target is redirected again; visitors end up at %s. Consider pointing this rule there directly."
msgstr "Целта се пренасочва отново; посетителите стигат до %s. По-добре насочете правилото направо там."

#: src/WordPress/Admin/Messages.php:50
msgid "Query mode \"exact\" is selected but the source has no query string, so only requests without one will match."
msgstr "Избран е режим „точно“ за query string-а, но източникът няма такъв, затова ще съвпадат само заявки без параметри."

#: src/WordPress/Admin/Messages.php:52
msgid "The target contains $1-style placeholders, which the Lite edition does not replace."
msgstr "Целта съдържа заместители като $1, които изданието Lite не попълва."

