#. Plugin Name of the plugin
#: pnscripts-waymend-lite.php
msgid "PN Scripts Waymend Lite – Redirects, 404 Log and Old URL Check"
msgstr "PN Scripts Waymend Lite – пренасочвания, 404 дневник и проверка на стари адреси"

#. Plugin URI of the plugin
#: pnscripts-waymend-lite.php
msgid "https://pnscripts.com/marketplace/wp-waymend"
msgstr "https://pnscripts.com/marketplace/wp-waymend"

#. Description of the plugin
#: pnscripts-waymend-lite.php
msgid "Keep old links working: 301, 302, 307 and 410 redirects by exact URL or prefix, a 404 log with one-click redirects, loop protection, and a check of the old site's URLs before a move."
msgstr "Старите връзки продължават да работят: пренасочвания 301, 302, 307 и 410 по точен адрес или префикс, дневник на 404 грешки с пренасочване с едно щракване, защита от цикли и проверка на адресите на стария сайт преди преместване."

#. Author of the plugin
#: pnscripts-waymend-lite.php
msgid "PN Scripts"
msgstr "PN Scripts"

#. Author URI of the plugin
#: pnscripts-waymend-lite.php
msgid "https://pnscripts.com"
msgstr "https://pnscripts.com"

#: pnscripts-waymend-lite.php:52
msgid "Waymend (full edition) is active, so Waymend Lite is not running. You can deactivate Waymend Lite."
msgstr "Waymend (пълната версия) е активен, затова Waymend Lite не работи. Можете да деактивирате Waymend Lite."

#: src/WordPress/Admin/Admin.php:55
msgid "Waymend redirects"
msgstr "Пренасочвания Waymend"

#: src/WordPress/Admin/Admin.php:56
#: src/WordPress/Admin/Admin.php:75
#: src/WordPress/Admin/Admin.php:102
#: src/WordPress/Admin/Admin.php:112
msgid "Redirects"
msgstr "Пренасочвания"

#: src/WordPress/Admin/Admin.php:93
#: src/WordPress/Admin/Admin.php:548
msgid "You do not have permission to manage redirects."
msgstr "Нямате права да управлявате пренасочванията."

#: src/WordPress/Admin/Admin.php:103
#: src/WordPress/Admin/Admin.php:515
msgid "404 log"
msgstr "404 дневник"

#: src/WordPress/Admin/Admin.php:104
msgid "Check old URLs and export"
msgstr "Проверка на стари адреси и износ"

#: src/WordPress/Admin/Admin.php:105
msgid "Settings"
msgstr "Настройки"

#: src/WordPress/Admin/Admin.php:114
#: src/WordPress/Admin/Admin.php:273
#: src/WordPress/Admin/Admin.php:327
msgid "Add redirect"
msgstr "Добавяне на пренасочване"

#: src/WordPress/Admin/Admin.php:160
msgid "Search redirects"
msgstr "Търсене"

#: src/WordPress/Admin/Admin.php:180
msgid "Test a URL"
msgstr "Проверка на адрес"

#: src/WordPress/Admin/Admin.php:183
msgid "Trace"
msgstr "Проследяване"

#. translators: %d: rule id.
#: src/WordPress/Admin/Admin.php:203
#, php-format
msgid "rule #%d"
msgstr "правило №%d"

#: src/WordPress/Admin/Admin.php:209
msgid "Loop: these rules send the visitor around in circles. Waymend stops at the URL it would redirect to itself, but fix the rules."
msgstr "Цикъл: тези правила въртят посетителя в кръг. Waymend спира при адреса, който би пренасочил към себе си, но поправете правилата."

#: src/WordPress/Admin/Admin.php:211
msgid "No rule matches this URL; WordPress handles it as usual."
msgstr "Нито едно правило не съвпада с този адрес; WordPress го обработва както обикновено."

#. translators: %d: number of redirects.
#: src/WordPress/Admin/Admin.php:214
#, php-format
msgid "%d redirect in a row. Point the first rule at the final URL to save visitors a round trip."
msgid_plural "%d redirects in a row. Point the first rule at the final URL to save visitors a round trip."
msgstr[0] "%d пренасочване подред. Насочете първото правило директно към крайния адрес, за да спестите на посетителите едно отиване и връщане."
msgstr[1] "%d пренасочвания подред. Насочете първото правило директно към крайния адрес, за да спестите на посетителите излишните стъпки."

#: src/WordPress/Admin/Admin.php:216
msgid "One redirect, no loop."
msgstr "Едно пренасочване, без цикъл."

#: src/WordPress/Admin/Admin.php:230
msgid "That redirect does not exist."
msgstr "Това пренасочване не съществува."

#: src/WordPress/Admin/Admin.php:258
msgid "301 Moved permanently"
msgstr "301 Преместено за постоянно"

#: src/WordPress/Admin/Admin.php:259
msgid "302 Found (temporary)"
msgstr "302 Временно преместено"

#: src/WordPress/Admin/Admin.php:260
msgid "307 Temporary redirect (keeps the method)"
msgstr "307 Временно пренасочване (запазва метода)"

#: src/WordPress/Admin/Admin.php:261
msgid "410 Gone (no target)"
msgstr "410 Премахнато (без цел)"

#: src/WordPress/Admin/Admin.php:264
msgid "Exact: this URL only"
msgstr "Точно: само този адрес"

#: src/WordPress/Admin/Admin.php:265
msgid "Prefix: this path and everything below it; the rest is appended to the target"
msgstr "Префикс: този път и всичко под него; остатъкът се добавя към целта"

#: src/WordPress/Admin/Admin.php:268
msgid "Ignore: match the path, drop the visitor's query string"
msgstr "Пропускане: съвпадение по пътя, query string-ът на посетителя отпада"

#: src/WordPress/Admin/Admin.php:269
msgid "Pass: match the path, append the visitor's query string to the target"
msgstr "Предаване: съвпадение по пътя, query string-ът се добавя към целта"

#: src/WordPress/Admin/Admin.php:270
msgid "Exact: the source's query parameters must be present, in any order"
msgstr "Точно: параметрите от източника трябва да присъстват, в произволен ред"

#: src/WordPress/Admin/Admin.php:273
msgid "Edit redirect"
msgstr "Редактиране на пренасочване"

#: src/WordPress/Admin/Admin.php:284
#: src/WordPress/Admin/Rules_Table.php:41
msgid "Source"
msgstr "Източник"

#: src/WordPress/Admin/Admin.php:286
msgid "A path on this site, such as /old-page/."
msgstr "Път в този сайт, например /old-page/."

#: src/WordPress/Admin/Admin.php:290
#: src/WordPress/Admin/Rules_Table.php:42
msgid "Target"
msgstr "Цел"

#: src/WordPress/Admin/Admin.php:292
msgid "A path on this site (/new-page/) or a full URL. Leave empty for 410 Gone."
msgstr "Път в този сайт (/new-page/) или пълен адрес. Оставете празно за 410."

#: src/WordPress/Admin/Admin.php:293
msgid "Suggested from a published item with a matching slug. Check it before saving."
msgstr "Предложено по публикувано съдържание с подобен slug. Проверете го, преди да запишете."

#: src/WordPress/Admin/Admin.php:296
#: src/WordPress/Admin/Rules_Table.php:44
msgid "Status"
msgstr "Статус"

#: src/WordPress/Admin/Admin.php:302
#: src/WordPress/Admin/Rules_Table.php:43
msgid "Match"
msgstr "Съвпадение"

#: src/WordPress/Admin/Admin.php:309
msgid "Case-sensitive"
msgstr "Различаване на главни и малки букви"

#: src/WordPress/Admin/Admin.php:313
msgid "Query string"
msgstr "Query string"

#: src/WordPress/Admin/Admin.php:321
msgid "Enabled"
msgstr "Включено"

#: src/WordPress/Admin/Admin.php:323
msgid "Active on the site"
msgstr "Действа в сайта"

#: src/WordPress/Admin/Admin.php:327
msgid "Save redirect"
msgstr "Запазване"

#: src/WordPress/Admin/Admin.php:336
msgid "404 logging is switched off in the settings."
msgstr "Записването на 404 грешки е изключено в настройките."

#: src/WordPress/Admin/Admin.php:341
msgid "Search 404s"
msgstr "Търсене"

#: src/WordPress/Admin/Admin.php:351
msgid "Clear the whole log"
msgstr "Изчистване на целия дневник"

#: src/WordPress/Admin/Admin.php:351
msgid "Delete every logged 404?"
msgstr "Да се изтрият ли всички записани 404 грешки?"

#: src/WordPress/Admin/Admin.php:360
msgid "Export CSV"
msgstr "Износ в CSV"

#: src/WordPress/Admin/Admin.php:361
msgid "Downloads every rule with its hit count and last hit, in the same format the importer reads."
msgstr "Изтегля всички правила с броя посещения и последното посещение, в същия формат, който вносът чете."

#: src/WordPress/Admin/Admin.php:365
msgid "Download CSV"
msgstr "Изтегляне на CSV"

#: src/WordPress/Admin/Admin.php:375
msgid "Check old URLs"
msgstr "Проверка на стари адреси"

#: src/WordPress/Admin/Admin.php:376
msgid "Moving or redesigning a site? Paste the old addresses (from the old sitemap, Search Console or an analytics export), one per line. The old domain is fine: each path is checked on this site, the way a visitor following an old link would land."
msgstr "Местите или преработвате сайт? Поставете старите адреси (от стария sitemap, Search Console или експорт от анализите), по един на ред. Старият домейн не пречи: всеки път се проверява на този сайт, точно както би стигнал посетител по стара връзка."

#: src/WordPress/Admin/Admin.php:382
msgid "Old URLs, one per line"
msgstr "Стари адреси, по един на ред"

#: src/WordPress/Admin/Admin.php:387
msgid "Check URLs"
msgstr "Провери адресите"

#. translators: %d: maximum number of URLs per check.
#: src/WordPress/Admin/Admin.php:389
#, php-format
msgid "Up to %d URLs per check."
msgstr "До %d адреса на проверка."

#. translators: %d: number of URLs not checked because of the time limit.
#: src/WordPress/Admin/Admin.php:408
#, php-format
msgid "Not checked (time limit, run again): %d"
msgstr "Непроверени (лимит на времето, пуснете отново): %d"

#. translators: %d: number of URLs that need a redirect.
#: src/WordPress/Admin/Admin.php:418
#, php-format
