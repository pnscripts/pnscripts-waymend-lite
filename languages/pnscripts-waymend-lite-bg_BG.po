msgstr "Пренасочен, работи"

#: src/WordPress/Admin/Admin.php:466
msgid "Works"
msgstr "Работи"

#: src/WordPress/Admin/Admin.php:476
msgid "Paste at least one old URL or path, one per line."
msgstr "Поставете поне един стар адрес или път, по един на ред."

#. translators: %d: number of lines that are not URLs.
#: src/WordPress/Admin/Admin.php:485
#, php-format
msgid "%d line is not a URL and was skipped."
msgid_plural "%d lines are not URLs and were skipped."
msgstr[0] "%d ред не е адрес и беше пропуснат."
msgstr[1] "%d реда не са адреси и бяха пропуснати."

#. translators: %d: maximum number of URLs per check.
#: src/WordPress/Admin/Admin.php:489
#, php-format
msgid "Only the first %d URLs were checked."
msgstr "Проверени са само първите %d адреса."

#: src/WordPress/Admin/Admin.php:517
msgid "Record URLs that return 404"
msgstr "Записване на адресите, които връщат 404"

#: src/WordPress/Admin/Admin.php:518
msgid "Stores the path, the number of hits, first and last time and the last referrer. No IP addresses or user agents."
msgstr "Пази пътя, броя посещения, първото и последното време и последния източник. Без IP адреси и user agent."

#: src/WordPress/Admin/Admin.php:522
msgid "Keep at most"
msgstr "Пазене на най-много"

#: src/WordPress/Admin/Admin.php:524
msgid "distinct 404 URLs; older ones are removed once a day."
msgstr "различни 404 адреса; по-старите се изтриват веднъж дневно."

#: src/WordPress/Admin/Admin.php:528
msgid "Do not log"
msgstr "Без записване на"

#: src/WordPress/Admin/Admin.php:530
msgid "One pattern per line, * matches anything. The defaults skip common vulnerability scans such as *.php and /.env."
msgstr "По един шаблон на ред, * съвпада с всичко. По подразбиране се пропускат честите сканирания за уязвимости като *.php и /.env."

#: src/WordPress/Admin/Admin.php:532
msgid "Default status for new redirects"
msgstr "Статус по подразбиране за нови пренасочвания"

