#: src/WordPress/Admin/Admin.php:432
#, php-format
msgid "Suggested: %s"
msgstr "Предложение: %s"

#. translators: %d: HTTP status code of WordPress's own redirect.
#: src/WordPress/Admin/Admin.php:435
#, php-format
msgid "(%d, WordPress redirects it further)"
msgstr "(%d, WordPress го пренасочва нататък)"

#: src/WordPress/Admin/Admin.php:449
msgid "The first 300 results are shown; the CSV has every URL that needs a redirect."
msgstr "Показани са първите 300 резултата; CSV файлът съдържа всички адреси, които имат нужда от пренасочване."

#: src/WordPress/Admin/Admin.php:459
msgid "Missing, needs a redirect"
msgstr "Липсва, трябва пренасочване"

#: src/WordPress/Admin/Admin.php:460
msgid "Redirected to a missing page"
msgstr "Пренасочен към липсваща страница"

#: src/WordPress/Admin/Admin.php:461
